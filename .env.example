# ============================================================
# CIVICSEVA ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================

# Database Connection
# For PostgreSQL (Docker or local): postgresql://civicseva:civicseva123@localhost:5432/civicsevadb
# Leave empty to automatically fallback to local SQLite (backend/civicseva.db)
DATABASE_URL=

# Authentication & Security
JWT_SECRET=civicseva_super_secret_jwt_key_2026_hackathon_demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Backend Host & Port
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# AIML Microservice
AIML_SERVICE_URL=http://localhost:8001
AIML_HOST=0.0.0.0
AIML_PORT=8001

# AI & LLM Providers (Optional: system runs in robust Built-in Deterministic Fallback mode if omitted)
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
VISION_API_KEY=
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-flash-latest
SPEECH_TO_TEXT_API_KEY=
SPEECH_TO_TEXT_BASE_URL=https://api.groq.com/openai/v1
SPEECH_TO_TEXT_MODEL=whisper-large-v3-turbo
ESCALATION_WEBHOOK_URL=
ESCALATION_WEBHOOK_TOKEN=
AUTONOMOUS_SWEEP_INTERVAL_SECONDS=900
ENABLE_AUTONOMOUS_SCHEDULER=true

# CivicSeva Assistant Overrides (Optional: inherits LLM_API_KEY & LLM_MODEL above if unset)
# ASSISTANT_LLM_API_KEY=
# ASSISTANT_LLM_MODEL=gpt-4o-mini
# ASSISTANT_LLM_BASE_URL=https://api.openai.com/v1
# ASSISTANT_LLM_PROVIDER=  # set to 'deterministic' to force offline fallback
# ASSISTANT_TIMEOUT_SECONDS=8
# ASSISTANT_MAX_TOKENS=600

# SLA Thresholds for Follow-up & Escalation (in hours, configurable)
SLA_HIGH_HOURS=24
SLA_MEDIUM_HOURS=48
SLA_LOW_HOURS=72

# Demo Fast-Simulation Mode (if true, seconds simulate hours for instant demo testing)
DEMO_FAST_SLA_SIMULATION=false
